BOT_TOKEN=123456:ABC-your-bot-token
# 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR, 50=CRITICAL
LOGGING_LEVEL=20

# Local peer auth: PG_HOST=/var/run/postgresql with empty PG_PASSWORD
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=aiogram_bot

FSM_HOST=localhost
FSM_PORT=6379
FSM_PASSWORD=

CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=

USE_WEBHOOK=false
# Required when USE_WEBHOOK=true
#MAIN_WEBHOOK_ADDRESS=https://example.com/tg/webhooks/bot/{token}
#MAIN_WEBHOOK_SECRET_TOKEN=random-secret-string
#MAIN_WEBHOOK_LISTENING_HOST=0.0.0.0
#MAIN_WEBHOOK_LISTENING_PORT=8080
#MAX_UPDATES_IN_QUEUE=100

USE_CUSTOM_API_SERVER=false
# Required when USE_CUSTOM_API_SERVER=true
#CUSTOM_API_SERVER_IS_LOCAL=true
#CUSTOM_API_SERVER_BASE=http://localhost:8081/bot{token}/{method}
#CUSTOM_API_SERVER_FILE=http://localhost:8081/file/bot{token}/{path}
